PORT=5001
NODE_ENV=development

# PostgreSQL connection string (local Postgres, Neon, Supabase, Render). Without it, runs live in memory only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anytask_ai?schema=public"

# Required: the agent plans goals and picks every action with this key.
OPENAI_API_KEY="your-openai-api-key-here"

# --- Access & safety --------------------------------------------------------
# Set this anywhere the backend is reachable by others. The dashboard asks for it once.
# ANYTASK_API_KEY="a-long-random-string"
# Comma-separated frontend origins allowed by CORS (default: any).
# CORS_ORIGIN="https://anytask-frontend.onrender.com"
# Block localhost / private-network targets (SSRF). Defaults to true when NODE_ENV=production.
# ALLOW_PRIVATE_TARGETS=false

# --- Runs -------------------------------------------------------------------
# Each run is a Chromium instance (~300MB). Extra runs wait in a queue.
# MAX_CONCURRENT_RUNS=2
# Run Chromium without a window (required on servers). Set to "false" locally to watch the agent.
HEADLESS=true

# --- Agent ------------------------------------------------------------------
# AGENT_MODEL="gpt-4.1-mini"
# AGENT_MAX_GOALS=5
# AGENT_MAX_STEPS_PER_GOAL=25
# Send a screenshot with every step (better on visual UIs, costs more tokens).
# AGENT_VISION=false

# --- Test accounts ----------------------------------------------------------
# With TEST_EMAIL_BASE set, sign-ups use plus-addressing (you+anytask-qa-xxxx@gmail.com)
# so verification emails reach a real inbox. Otherwise TEST_EMAIL_DOMAIN (default example.com) is used.
# TEST_EMAIL_BASE="you@gmail.com"
# TEST_EMAIL_DOMAIN="example.com"
# Your own phone for SMS/OTP flows. Without it a fake number is used and OTP sends are blocked.
# TEST_PHONE="9876543210"

# --- Screenshot storage -----------------------------------------------------
# "local" (default) writes to test-results/screenshots, which hosts like Render wipe on deploy.
# "s3" works with AWS S3, Cloudflare R2, Backblaze B2 or MinIO.
# SCREENSHOT_STORAGE=s3
# S3_BUCKET="anytask-screenshots"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # omit for AWS S3
# S3_REGION="auto"                                               # e.g. us-east-1 for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
